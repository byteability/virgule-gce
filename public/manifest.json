{
  "manifest_version": 3,
  "name": "Virgule",
  "version": "2.2.0",
  "description": "Display, edit, and organize Markdown files with a built-in folder explorer.",
  "key": "",
  "action": {
    "default_title": "Open Virgule"
  },
  "chrome_url_overrides": {
    "newtab": "app.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_GOOGLE_CLOUD_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  }
}
