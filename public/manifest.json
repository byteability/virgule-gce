{
  "manifest_version": 3,
  "name": "Virgule",
  "version": "2.0.2",
  "description": "Display, edit, and organize Markdown files with a built-in folder explorer.",
  "action": {
    "default_title": "Open Virgule"
  },
  "chrome_url_overrides": {
    "newtab": "app.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "storage"
  ]
}
